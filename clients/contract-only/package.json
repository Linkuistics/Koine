{
  "name": "koine-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free CLI client generated against the koine-desktop/1 published contract.",
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "node build.mjs",
    "build": "npm run codegen && npm run typecheck && npm run bundle && npm test",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typed-document-node": "^5.1.2",
    "esbuild": "^0.25.10",
    "graphql": "^16.11.0",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
