  "env_vars": [
    {
      "description": "VM instance id; resolves the per-VM connection spec.",
      "internal": false,
      "name": "TESTANYWARE_VM_ID"
    },
    {
      "description": "VNC endpoint host[:port] (ad-hoc, no spec file).",
      "internal": false,
      "name": "TESTANYWARE_VNC"
    },
    {
      "description": "Agent HTTP endpoint host[:port].",
      "internal": false,
      "name": "TESTANYWARE_AGENT"
    },
    {
      "description": "Target platform: macos, linux, windows.",
      "internal": false,
      "name": "TESTANYWARE_PLATFORM"
    },
    {
      "description": "Another config.rhai file for the Host CLI, or `none` to run without one. The default is ~/.config/testanyware/config.rhai. The app does not read this variable.",
      "internal": false,
      "name": "TESTANYWARE_CONFIG"
    },
    {
      "description": "Socket of the TestAnyware app, for tests. Overrides the default socket on a macOS host, and turns routing through the app on elsewhere.",
      "internal": true,
      "name": "TESTANYWARE_APP_SOCKET"
    },
    {
      "description": "Force a single primary RFB encoding (zrle|tight|raw) so the live-VM gate can exercise each decoder; not part of the stable contract.",
      "internal": true,
      "name": "TESTANYWARE_RFB_ENCODING"
    }
  ],
