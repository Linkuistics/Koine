flowchart TD
  start["Start here<br/>Sequence caller owns declarations and preflight<br/>One immutable plan per slot"]:::start
  setup{"Preflight, bootstrap and readiness?"}
  ready["Start once<br/>Prepare observer before scenario input"]
  nostart["Preflight failure or incomplete bootstrap<br/>No collection attempts<br/>Retain available sequence output and missing audits"]:::held
  endrun["Suppress future ticks<br/>Retain first outcome and held-input state"]
  owner{"Original owner available?"}
  live["Settle active holder<br/>Keep original lock"]
  recover["Original caller only<br/>Resolve all holders and acquire original lock<br/>Check complete bootstrap, ranges and frontier"]
  entry["Burn uncertain ranges<br/>Publish 25, 20, 5, 20<br/>No repeated collection item"]
  prefix["Failure only: indices 1–3<br/>Observer → windows → screenshot<br/>Then conditional liveness/front-app reads"]
  audits["Indices 6–21 where prerequisites hold<br/>Guest evidence and local audits<br/>Local-audit family remains k126 work"]
  contain["Indices 22–23<br/>One exact stop → independent inventory"]
  final["Indices 24–25<br/>Sequence-final golden audit when applicable<br/>Separate outcomes and NOT RUN phases"]
  tail["Schema final transfer<br/>Normal: 25, 20, 27, 20, 28<br/>Recovery final: 27, 20, 28"]
  unavailable["Collection unavailable<br/>Preserve uncertainty<br/>Block later slots"]:::held
  start --> setup
  setup -->|"Complete"| ready
  setup -->|"Preflight or bootstrap incomplete"| nostart
  setup -->|"Complete bootstrap, failed readiness"| recover
  ready -->|"1. Scenario ends or fails"| endrun
  endrun -->|"2. Settle ownership"| owner
  owner -->|"Yes"| live
  owner -->|"No"| recover
  recover -->|"Proof complete"| entry
  recover -->|"Unknown holder, frontier or capacity"| unavailable
  entry -->|"Entry complete"| prefix
  entry -->|"Entry failed, no retry"| unavailable
  live -->|"3. Failure context, if applicable"| prefix
  prefix -->|"4. No corrective input"| audits
  audits -->|"5. Independent applicable items"| contain
  contain -->|"6. Retain both results"| final
  final -->|"7. Available publication"| tail
  live -->|"Unresolved holder after containment expiry"| unavailable
  prefix -->|"Unresolved holder after containment expiry"| unavailable
  audits -->|"Unresolved holder after containment expiry"| unavailable
  contain -->|"Unresolved holder after containment expiry"| unavailable
  classDef start fill:#172f49,color:#fff,stroke:#172f49,font-weight:bold
  classDef held fill:#fff0db,color:#402800,stroke:#a76b00
