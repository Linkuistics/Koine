flowchart TD
    start["Start here: caller<br/>observes owner outcome"]:::start
    handoff["Complete handoff<br/>Original lock transferred"]
    gate{"Holders resolved?<br/>Same lock, identities<br/>and unique frontier?"}
    normal["Normal transfer<br/>25 → 20"]
    entry["One successor<br/>25 → 20 → 5 → 20"]
    collect["Delayed observations<br/>Unattempted suffix only"]
    unknown["Recovery unavailable<br/>No replacement writer"]
    final["Both paths<br/>27 → 20 → 28"]
    result["Caller observes final write<br/>Loss leaves unknown tail"]
    start -->|1a. Owner completes| handoff
    start -->|1b. Owner lost| gate
    handoff -->|2a. Burn unused ranges| normal
    gate -->|No| unknown
    gate -->|2b. Yes: burn owner ranges| entry
    entry -->|3. Entry complete| collect
    normal --> final
    collect -->|4. Burn successor suffix| final
    final -->|5. No recursive final logger| result
    classDef start fill:#17324d,color:#fff,font-weight:bold,stroke:#17324d
