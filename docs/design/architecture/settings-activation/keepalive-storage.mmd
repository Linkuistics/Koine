%%{init: {"flowchart": {"useMaxWidth": true}}}%%
flowchart TD
    start["Start here: original writer lock<br/>and complete bounded pool"]:::start
    fence["Publish fence in odd terminal slot<br/>Observe required write and flush results"]
    bind["Recheck, assign ordinal and charge<br/>Publish storage binding in even slot"]
    directory["Create exact directory once<br/>Ordinary or protected collection backing"]
    commit["Publish commitment and its kind 20<br/>Both precede child creation"]
    next{"Current fence has permitted unused member?"}
    loss["Owner loss at any boundary"]
    holders{"Holders resolved, same lock acquired,<br/>backing and layout identities valid?"}
    frontier{"Unique fence frontier?<br/>No torn or conflicting fence"}
    burn["Burn owner slots, attachments and uncertain ordinals<br/>Retain unknown charges. No refund"]
    recover["Publish entry rows 25 → 20 → 5 → 20<br/>Then delayed observations and an unattempted item"]
    unavailable["Collection unavailable<br/>No replacement lock, ordinal or scenario"]
    start -->|1| fence
    fence -->|2| bind
    bind -->|3| directory
    directory -->|4| commit
    commit -->|5. Full operation completion before next selection| next
    next -->|Yes| bind
    next -->|No: next fence permitted by protocol| fence
    fence -.-> loss
    bind -.-> loss
    directory -.-> loss
    commit -.-> loss
    loss --> holders
    holders -->|No| unavailable
    holders -->|Yes| frontier
    frontier -->|No| unavailable
    frontier -->|Yes| burn
    burn --> recover
    recover -->|New fence: one ordinal per collection item| fence
    classDef start fill:#17324d,stroke:#17324d,color:#fff,font-weight:bold
