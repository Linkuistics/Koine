flowchart TB
  caller["Start here: finite caller\nOwn run, exact VM and private root"]:::start
  scenario["Scenario helpers\nOne outstanding submission"]
  worker["Owned keepalive worker\nSleep 20, submit one tick\nAwait complete disposition before next sleep"]
  owner["Command owner and supervisor\nTwo outstanding operations total\nAt most one active"]
  gate{"Eligible at dispatch?\nNo prior failure or stop"}
  operation["Owner reserves ordinal and publishes commitment\nChild: CLI, validation and backend receipt\nOwner: payload acknowledgement and terminal record"]
  stop["Close eligibility and suppress ticks\nCancel unstarted work without attempt ordinal"]
  collection["Settle owned holder and reap worker\nThen untouched collection and exact clone stop"]
  profile["Proposed receive-order schedule and deadlines\nProducer limits and workload remain unresolved\nMissing complete profile prohibits startup"]:::open
  caller -->|"1. create and own"| owner
  owner -->|"2. create and join"| worker
  scenario -->|"submission / result"| owner
  worker -->|"tick / result / matched stop"| owner
  owner -->|"3. choose under reviewed profile"| gate
  gate -->|"yes"| operation
  operation -->|"completion frame after terminal publication"| owner
  gate -->|"no"| stop
  operation -->|"failure: retain original outcome"| stop
  owner -->|"normal end or signal"| stop
  stop --> collection
  profile -.-> owner
  classDef start fill:#183849,color:#fff,stroke:#183849,font-weight:bold
  classDef open fill:#fff2d6,color:#302410,stroke:#a66d00,stroke-dasharray:5 5
