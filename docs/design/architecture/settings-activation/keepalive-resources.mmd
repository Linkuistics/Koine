flowchart TB
  start["Start here: one run profile"]:::start
  proof{"Producer bounds established?"}
  storage{"Collection and terminal capacity protected?"}
  admission["Admission checks capacity\nNo operation charge"]
  commit["Commitment transition rechecks and charges\nReserve directory and publish commitment"]
  launcher{"Launcher installs limits\nActual setup and readback observed?"}
  producer["Run bounded producer"]
  validate["Validate and publish\nRetain originals and partials"]
  next["Permit later dispatch"]
  hold["Refuse startup or later dispatch\nPreserve failed or unavailable outcome"]:::open
  candidates["Candidates only\nInherited limits and reserved storage"]:::open
  start -->|"1. establish evidence"| proof
  proof -->|"2. established"| storage
  proof -->|"missing or inapplicable"| hold
  storage -->|"3. protected"| admission
  storage -->|"missing or exhausted"| hold
  admission -->|"4. eligible at commitment"| commit
  admission -->|"resource refusal: no ordinal or operation charge"| hold
  commit -->|"5. committed attempt"| launcher
  commit -->|"reservation or publication failure: retain charge"| hold
  launcher -->|"6. enforcement established before execution"| producer
  launcher -->|"setup or readback refusal: no external invocation"| hold
  producer -->|"7. complete output"| validate
  validate -->|"8. complete publication and delivery"| next
  producer -->|"limit, death or partial output"| hold
  validate -->|"failure or missing record"| hold
  candidates -.-> proof
  candidates -.-> storage
  classDef start fill:#183849,color:#fff,stroke:#183849,font-weight:bold
  classDef open fill:#fff2d6,color:#302410,stroke:#a66d00,stroke-dasharray:5 5
