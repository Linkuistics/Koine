flowchart TD
  start["Start here<br/>One E or A slot"]:::start
  boot["Bootstrap and start<br/>600-second queue;<br/>boot costs unresolved"]
  prep["Begin sleep20 cadence<br/>Install and allow Automation"]
  prefix["Shared prefix<br/>Four Settings choices<br/>then TextEdit quit"]
  kind{"Declared slot"}
  ordinary["Complete A continuation<br/>Resize through final Quit"]
  expand["Expand helpers<br/>Polls, waits and objects"]
  internal["Include internal frames<br/>OCR and input confirmation"]
  stop["Suppress ticks<br/>Drain, stop and reap"]
  failure["First failure or signal<br/>Close eligibility;<br/>retain charged work"]
  collect["Applicable collection<br/>Original lock and holders;<br/>context, audits, containment"]
  tail["Original caller tail<br/>Normal or one successor"]
  proof["Next: combined accounting<br/>Time, ticks, records,<br/>fences and physical costs"]
  missing["Exact inputs still missing<br/>Startup unavailable"]:::held
  start --> boot
  boot -->|"Clean start"| prep
  prep --> prefix
  prefix --> kind
  kind -->|"E: end before resize"| stop
  kind -->|"A"| ordinary
  ordinary -->|"Declared completion"| stop
  prep -.-> expand
  prefix -.-> expand
  ordinary -.-> expand
  expand -.-> internal
  internal -.-> proof
  boot -->|"Failure or unknown start"| failure
  prep -->|"Failure or signal"| failure
  prefix -->|"Failure or signal"| failure
  ordinary -->|"Failure or signal"| failure
  stop -->|"Failed stop or missing join"| failure
  failure --> collect
  stop -->|"Normal audits and exact containment"| collect
  collect --> tail
  tail -.-> proof
  proof -.-> missing
  classDef start fill:#172f49,color:#fff,stroke:#172f49,font-weight:bold
  classDef held fill:#fff0db,color:#402800,stroke:#a76b00
