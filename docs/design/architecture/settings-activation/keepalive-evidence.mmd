flowchart TD
    start["Start here: preserve every required guarantee"]
    manifest["Pin exact subjects, sources, builds and environment"]
    producer["Producer: versioned units, input occurrences, OCR cycles and pre-growth guards"]
    platform["Platform: proposed real Fe method, separate Fi and bootstrap/service bounds"]
    native["Native: derived call maxima, frame sources and crash-reporting costs or proven suppression"]
    raw["Raw: Q, R3 capacity feasibility, loader effects and independent blocking/accepted-byte oracle"]
    local["Storage and caller: protected metadata, finite local work and statuses"]
    complete{"All required inputs and complete costs available?"}
    hold["Unavailable: retain gaps and originals. No execution request"]
    choice["If evidence cannot be supplied: Antony funds qualification or explicitly revises the requirement"]
    review["Review concrete study and integrate supported repairs"]
    authority{"Exact execution authority obtained?"}
    study["Only the frozen finite study; retain failures and unknowns"]
    fit["K126: reconcile all families and solve useful fit"]
    whole["Whole-design review before planning and implementation"]
    start --> manifest
    manifest --> producer
    manifest --> platform
    manifest --> native
    manifest --> raw
    manifest --> local
    manifest -.->|Available design inputs without execution| fit
    producer --> complete
    platform --> complete
    native --> complete
    raw --> complete
    local --> complete
    complete -->|No| hold
    complete -->|Yes| review
    review --> authority
    authority -->|No| hold
    authority -->|Yes| study
    hold --> choice
    choice -.->|Reviewed revised inputs| manifest
    study --> fit
    fit --> whole
    classDef entry fill:#172b4d,color:#fff,stroke:#172b4d,font-weight:bold
    class start entry
