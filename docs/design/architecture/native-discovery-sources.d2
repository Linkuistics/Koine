# Bounded source analysis and agreed settings route; no qualified runtime backend.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Native sources\nmacOS 26+; runtime checks pending" {class: start}
Locations: "Foundation locations\nAccount + kind + domain"
LocationLimit: "Starting values only\nNo listing, access or existence proof"
Apps: "Application breadth\nFixed indexed-local + running"
Copies: "Complete bounded population\nShared per-ID / per-copy facts"
AppLimit: "Global overflow: FAILED / null\nClient filters; P1024 pending"
Settings: "System Settings objects\nUnchanged posture first;\nlocal UI consent if needed"
Choice: "Explicit background preparation\nEffect-free reads; panes + anchors"
Contract: "Designed source contract\nMandatory review; native G/N/V pending"
Client: "Clients derive choices\nRaw search, permissions, filtering"
Start -> Locations: "1 · value source"
Locations -> LocationLimit: "2 · value limit"
Start -> Apps: "1 · indexed breadth"
Apps -> Copies: "2 · observed metadata"
Copies -> AppLimit: "3 · source + identity limits"
Start -> Settings: "1 · source evidence"
Settings -> Choice: "2 · human requirements settled"
LocationLimit -> Contract: "4 · retain provenance"
AppLimit -> Contract: "4 · no native pass"
Choice -> Contract: "4 · qualify useful behavior"
Contract -> Client: "5 · implementation + acceptance"
