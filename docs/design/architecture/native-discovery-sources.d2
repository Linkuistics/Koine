# Bounded source analysis and agreed settings route; no qualified runtime backend.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Native source boundary\nmacOS 26+; analysis and agreed settings direction" {class: start}
Locations: "Public Foundation locations\nAccount + kind + domain; starting values"
LocationLimit: "No create / contents listing / access grant\nExistence and client access stay unknown"
Apps: "Application-category candidates\nIndexed Spotlight + running observations"
Copies: "Per-observed-identifier registration\nValidate per-copy native identity"
AppLimit: "Unknown all-disk completeness\nExact prompt / hydration qualification pending"
Settings: "Modern System Settings · Preferred app scripting\nUnchanged posture first; explicit setup only if needed"
Choice: "Agreed background preparation if stopped\nEffect-free reads; useful runtime panes and anchors"
Contract: "Final contract + mandatory producer review\nAPI, bounds, effects, exact G / N / V subjects"
Client: "Client derives choices\nRaw search, permissions, filtering and ranking"
Start -> Locations: "1 · value source"
