# Bounded source analysis; candidates are not selected/qualified backends.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Native source boundary\nmacOS 26+; source analysis only" {class: start}
Locations: "Public Foundation locations\nAccount + kind + domain; starting values"
LocationLimit: "No create / contents listing / access grant\nExistence and client access stay unknown"
Apps: "Application-category candidates\nIndexed Spotlight + running observations"
Copies: "Per-observed-identifier registration\nValidate per-copy native identity"
AppLimit: "Unknown all-disk completeness\nExact prompt / hydration qualification pending"
Settings: "Modern System Settings\nDictionary; sidebar data; individual SDK targets"
Choice: "Source / posture decision required\nNo silent reduction to two destinations"
Contract: "Final contract + mandatory producer review\nAPI, bounds, effects, exact G / N / V subjects"
Client: "Client derives choices\nRaw search, permissions, filtering and ranking"
Start -> Locations: "1 · value source"
Locations -> LocationLimit: "2 · value limit"
Start -> Apps: "1 · breadth candidate"
Apps -> Copies: "2 · observed metadata"
Copies -> AppLimit: "3 · source + identity limits"
Start -> Settings: "1 · source evidence"
Settings -> Choice: "2 · unapproved trade-off"
LocationLimit -> Contract: "4 · retain provenance"
AppLimit -> Contract: "4 · no native pass"
Choice -> Contract: "4 · after explicit decision"
Contract -> Client: "5 · implementation / acceptance still required"
