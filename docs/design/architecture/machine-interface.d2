# General control-flow view. Authorization precedes every provider callback.
direction: down
classes: {start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}}
Request: "Start here · authenticated GraphQL request" {class: start}
Validate: "Validate and coerce\nSelect operation · expand fragments · honor directives"
Read: "Query\nGuard each selected field by its schema coordinate"
Preflight: "Mutation\nCheck capabilities for ALL selected root actions"
Denied: "Reject before execution\nNo provider action starts"
Admit: "For each root action, in order\nCheck current grant at dispatch admission"
Act: "Provider re-resolves target and acts\nNo rollback promise"
Result: "Complete selected outputs\nGraphQL error paths and non-null propagation"
Request -> Validate
Validate -> Read: query
Validate -> Preflight: mutation
Preflight -> Denied: any action denied
Preflight -> Admit: all allowed
Admit -> Act: still authorized
Admit -> Result: revoked before admission
Act -> Admit: next action
Act -> Result: completed or failed
Read -> Result: values or explicit errors
