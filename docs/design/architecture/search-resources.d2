# Selected mechanism, subject to human choices/review/native acceptance.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Admitted job\nAt most four process-wide" {class: start}
Child: "One live / unreaped find child\nFixed argv; two concurrent pipe drains"
Native: "Native metadata in Koine\nCopied-value bounds; opaque peaks unproved"
Freeze: "Cancel / deadline / revocation / stop\nFreeze publication; no later source"
Cleanup: "TERM then KILL if still owned\nDrain, close, exactly one reap"
Release: "Release slot\nOnly after child + native work finish"
Start -> Child: "1 · authorized root"
Start -> Native: "1 · approved target access"
Child -> Freeze: "2 · stop"
Native -> Freeze: "2 · stop"
Freeze -> Cleanup: "3 · synchronized PID ownership"
Cleanup -> Release: "4 · actual completion"
