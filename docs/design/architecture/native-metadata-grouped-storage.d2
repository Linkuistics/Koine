direction: down
start: "Start here\nAll ordered spellings" {
 style.fill: "#16324f"
 style.font-color: white
 style.bold: true
}
inventories: "Independent inventories\nDirect and table owners\nAll raw keys retained\nLocProvenance reserved"
slabs: "Append-only slabs\nOld/new owners overlap\nNo relocation or refund"
frozen: "Freeze before borrowing\nExact suffix-free spans\nSlot held to true return"
replacement: "Replace whole key partitions\nKeep reads and field writes\nProvider owns publication"
subtotal: "Local + controlled paths\n20,444,806 / 20,618,913\nPartial counts only"
walks: "Add both walk states/literals\n23,238,610 / 23,412,717\nOver 20,971,520"
conditional: "Five episode / four job tapes\nNative work and wire unknown\nPreserve useful breadth"
hold: "Failed candidate\nKeep advertisement / consumption hold\nNo useful fit or native pass"
choice: "Selected guarded qualification first\nAnalytic fit is not a private prerequisite\nDesign complete; eligibility still pending"
review: "Complete guarded private design\nWhole review + prerequisite reviews / k30 placement\nBefore private implementation"
private: "Private guarded N5 / N8 / V11 / V13\nEnforce all existing gates\nNo useful source or locale reduction"
accept: "Full actual useful qualification\nNative operands / full responses / witnesses\nIndependent serviceability before consumption"
start -> inventories: "1. Preserve observations"
inventories -> slabs: "2. Charge every write"
slabs -> frozen: "3. Keep spans stable"
frozen -> replacement: "4. Retire after return"
replacement -> subtotal: "5. Complete replacements"
subtotal -> walks: "6. Disjoint walk subterms"
walks -> conditional: "7. No runtime lower bound"
conditional -> hold: "8. Keep unknowns unknown"
hold -> choice: "9. Apply selected ordering"
choice -> review: "10. Complete the design boundary"
review -> private: "11. Qualify through existing seams"
private -> accept: "12. Failed or missing cases keep holds"
