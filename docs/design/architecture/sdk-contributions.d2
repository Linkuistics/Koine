# Interface dependency view. Shared resilient Swift framework is agreed.
direction: down
classes: {start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}}
Author: "Start here · Swift provider author" {class: start}
Bundle: "Separate provider binary" {
  style.font-size: 22
  Manifest: "Signed manifest\nFramework major / minimum minor · required features"
  Schema: "Introspectable schema\nOwned fields · explicit authority metadata"
  Factory: "Named principal class\nConforms to ProviderFactory"
  Provider: "Swift Provider implementation\nOwned values · async resolution"
  Factory -> Provider: creates
}
Framework: "AGREED · shared Swift framework\nProvider protocols · resilient value types\nOne host-supplied binary image"
Host: "Koine host" {
  style.font-size: 22
  Loader: "Before loading\nVerify trust, dependencies and framework compatibility"
  Registry: "Before activation\nValidate schema and complete policy metadata"
  Executor: "For each call\nAuthorize · invoke · complete GraphQL output"
  Loader -> Registry
  Registry -> Executor
}
Author -> Bundle.Provider
Author -> Bundle.Schema
Author -> Bundle.Manifest
Bundle.Manifest -> Host.Loader
Bundle.Schema -> Host.Registry
Bundle.Provider -> Framework: dynamically links
Host.Executor -> Framework: dynamically links
Framework -> Bundle.Provider: Swift protocol dispatch
Note: "Native providers share Koine's trust and failure domain.\nSwift framework evolution preserves supported compiled consumers.\nUpdates activate at restart; no live unload."
