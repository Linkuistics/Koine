# Proposed v1 long-location action flow; no native reachability or runtime acceptance claim.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Selected: "Start here · Client-selected location\nAction fixture or search result, any length\nApp launch: identifier AND applicationPath" {class: start}
Input: "Literal absolute input\nNo length bound: length is not a caller error"
Resolve: "Location resolution\nSearch-only handles, one component per call\nKernel link / dot / trailing-slash semantics"
Limit: "Application hand-off limit\nLiteral, expanded and resolved spellings\nEach must fit PATH_MAX (1,024 incl. NUL)"
Classify: "Accepted short-path route, unchanged\nType / app / alias flags, registration, identifier\nAddressed by the resolved spelling"
Handler: "Default handler lookup\nNil for a resolved target: NO_DEFAULT_HANDLER"
Submit: "One native request · caller's target bytes\nApp: registered URL, device+inode identity\nBoth controls · 3 s wait; earlier core deadline"
Receipt: "Receipt observation\nproc_pidpath executable, resolved the same way\nExisting null rules; no length-caused null"
Result: "Acknowledgment / failed / unknown transport\nNo replay"
Refusal: "Hand-off refusal · failed, no request\nGuidance: stage, spelling, byte count\nApplication support deferred: Koine#1"
Failure: "failed before submission\nLink budget, denial, unacquired facts\nLater nil / ENOENT / ENAMETOOLONG is never absence"
Dependency: "DEPENDENCY_UNAVAILABLE · no request\nMissing, dangling, cycle, impossible component\nMismatch or established no handler"
Refused: "Input error · original response path\nInvalid syntax, or program / app / alias payload"
Selected -> Input: "1 · explicit action with both controls"
Input -> Refused: "2 · invalid syntax"
Input -> Resolve: "2 · valid syntax"
Resolve -> Dependency: "3 · established absence"
Resolve -> Failure: "3 · budget or error"
Resolve -> Limit: "3 · found"
Limit -> Refusal: "4 · a spelling needs ≥ 1,024 bytes"
Limit -> Classify: "4 · every spelling fits"
Classify -> Refused: "5 · refused payload"
Classify -> Dependency: "5 · missing app / mismatch"
Classify -> Failure: "5 · metadata failure"
Classify -> Handler: "5 · default document open"
Classify -> Submit: "5 · launch / named open / reveal"
Handler -> Submit: "6 · handler found"
Handler -> Dependency: "6 · no handler"
Submit -> Receipt: "7 · acknowledged launch/open"
Submit -> Result: "7 · reveal / error / wait expiry"
Receipt -> Result: "8 · process or null"
