# v1 long-location action flow after review integration; no native reachability or runtime acceptance claim.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Selected: "Start here · Client-selected location\nAction fixture or search result, any length\nApp launch: identifier, optional applicationPath" {class: start}
Input: "Literal absolute input\nNo length bound: length is not a caller error"
Resolution: "Location resolution, used by every stage\nSearch-only handles, one component per call\nAbsent: missing, dangling; for a target also a repeated\nstate or impossible ASCII name · Final component never opened\nfailed: 33rd expansion, other ENAMETOOLONG, denial"
Target: "Target stage · open and reveal\nResolve the caller's path, then the limit\nThen type / app / alias flags; open's payload policy"
Supplied: "Supplied applicationPath\nResolve, limit, then bundle metadata\nRegistered candidates by device+inode, to first match\nMissing or unequal skipped, never limited"
Discovered: "Discovered application\nPreferred copy · default handler · Finder\nA discovery read, then resolve"
Chosen: "Selected application\nLimit its spellings first\nThen its pathname metadata"
Handler: "Below the limit: accepted short-path route\nAddressed by the resolved spelling"
Submit: "One native request · caller's target bytes\nApp: registered URL · Both controls\n3 s wait; earlier core deadline"
Receipt: "Receipt observation\nproc_pidpath executable, resolved the same way\nExisting null rules; no length-caused null"
Result: "Acknowledgment / failed / unknown transport\nNo replay"
Refusal: "Hand-off refusal · failed, no request\nSpelling of 1,024 bytes or more, NUL not counted\nGuidance: stage, spelling, byte count · Koine#1"
Failure: "failed before submission\nResolution error, unknown candidate equality,\nunacquired facts; later nil is never absence"
Dependency: "DEPENDENCY_UNAVAILABLE · no request\nPATH_NOT_FOUND · APPLICATION_NOT_INSTALLED\nIDENTITY_MISMATCH · NO_DEFAULT_HANDLER"
Refused: "Input error · original response path\nInvalid syntax, or program / app / alias payload"
Selected -> Input: "1 · explicit action with both controls"
Input -> Refused: "2 · invalid syntax"
Input -> Target: "2 · open / reveal"
Input -> Supplied: "2 · launch with applicationPath"
Input -> Discovered: "2 · launch by identifier"
Target -> Resolution: "uses" {style.stroke-dash: 3}
Target -> Dependency: "3 · target absent"
Target -> Failure: "3 · resolution or metadata error"
Target -> Refusal: "3 · target over the limit"
Target -> Refused: "3 · refused payload"
Target -> Supplied: "3 · named open with applicationPath"
Target -> Discovered: "3 · default handler, named open by identifier, Finder"
Supplied -> Resolution: "uses" {style.stroke-dash: 3}
Supplied -> Refusal: "4 · chosen copy over the limit"
Supplied -> Dependency: "4 · absent, non-app, unregistered, mismatch"
Supplied -> Failure: "4 · a candidate fails to resolve"
Supplied -> Chosen: "4 · matching registration"
Discovered -> Resolution: "uses" {style.stroke-dash: 3}
Discovered -> Dependency: "4 · none registered, nil handler, stale"
Discovered -> Failure: "4 · resolution error"
Discovered -> Chosen: "4 · found"
Chosen -> Refusal: "5 · a spelling of 1,024+ bytes"
Chosen -> Dependency: "5 · non-application or mismatch"
Chosen -> Failure: "5 · metadata failure"
Chosen -> Handler: "5 · every spelling fits"
Handler -> Submit: "6 · submit"
Submit -> Receipt: "7 · acknowledged launch/open"
Submit -> Result: "7 · reveal / error / wait expiry"
Receipt -> Result: "8 · process or null"
