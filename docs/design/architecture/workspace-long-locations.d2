# Action prerequisite flow; no native reachability or runtime acceptance claim.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Selected: "Start here · Client-selected location\nAction fixture now; actual search handoff later\nApp launch: identifier AND applicationPath" {class: start}
Input: "Literal absolute input\nSearch ceiling: 8192 UTF-8 bytes\nSource length is no presence/action verdict"
Lookup: "Resolve source and expanded target\nExisting stat/realpath route is PATH_MAX-limited\nComponent lookup is only a candidate building block"
Classify: "Native payload / bundle / identity / registration\nReplacement long-location route unresolved\nNo guessed type or unknown registration negative"
Handler: "Default file-URL handler discovery\nSeparate native consumer / nil provenance / prompts\nTarget presence cannot validate handler lookup"
Submit: "One native request · target bytes preserved\nApp URL: registered spelling, constrained native identity\nBoth controls · 3 s wait; earlier core deadline"
Receipt: "Launch/open receipt observation\nCallback executable + proc_pidpath/live identity\nRecord null cause; systematic long-app loss unaccepted"
Result: "Acknowledgment / failed / unknown transport\nControlled independent delivery, selection and copy witnesses\nLong actions and actual-search handoff both pending"
Failure: "Designed 1.0.1 repair · unimplemented\nWhole/expanded size / unresolved link budget / unacquired facts\nPre-submission failed · no domain request"
Dependency: "DEPENDENCY_UNAVAILABLE · no request\nEstablished missing prerequisite / mismatch / no handler\nProven cycle or impossible component: PATH_NOT_FOUND"
Refused: "Input error · original response path\nInvalid syntax or native program / application / alias\nNo handler lookup or submission for refused payload"
Selected -> Input: "1 · explicit action with both controls"
Input -> Lookup: "2 · valid syntax, not actionability"
Input -> Refused: "2 · invalid syntax"
Lookup -> Classify: "3 · presence established"
Lookup -> Failure: "3 · refusal / uncertainty"
Lookup -> Dependency: "3 · established absence / unresolvable target"
Classify -> Failure: "4 · failure, not fabricated absence"
Classify -> Dependency: "4 · established missing app / mismatch"
Classify -> Refused: "4 · refused open payload"
Classify -> Handler: "4 · default document open only"
Classify -> Submit: "4 · ready launch / named open / reveal"
Handler -> Submit: "5 · applicable lookup and present handler"
Handler -> Dependency: "5 · established no handler"
Handler -> Failure: "5 · unestablished acquisition"
Submit -> Receipt: "6 · acknowledged launch/open"
Submit -> Result: "6 · reveal / error / wait expiry; no replay"
Receipt -> Result: "7 · process or null; separate acceptance"
