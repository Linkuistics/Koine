# Selected mechanism, subject to human choices/review/native acceptance.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Selected tool route\nPermission premise is OPEN" {class: start}
Process: "Human process choice\nAllow ordinary Apple-signed find child?"
Target: "Human protection choice\nLookup-only target identities + residual limit?"
Return: "Returned permission design\nRoots, prune, native targets, diagnostics"
Observe: "Signed-VM acceptance\nActual child identity + dialog/hydration controls"
Revise: "If refused / route cannot satisfy answer\nExplicit alternate engine or setup/domain decision"
Start -> Process: "1 · prior helper refusal still matters"
Process -> Target: "2 · separate protection question"
Target -> Return: "3 · only within exact answers"
Process -> Revise: "refusal"
Target -> Revise: "refusal / unsatisfied protection"
Return -> Observe: "4 · after mandatory review"
