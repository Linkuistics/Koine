direction: down
start: "Start here\nAntony selected scoped explicit work" {
 style.fill: "#16324f"
 style.font-color: white
 style.bold: true
}
raw: "Controlled raw staging\nRequested capacity + every performed write\n64-byte header / owners / growth / cleanup"
calls: "Real source access and ProviderValue adapter\nExplicit calls / comparisons / retain / release charged\nProvider owns real Swift values"
reserve: "Reserve work + retained / possible cleanup\nRaw cleanup + failure envelope + guard writes\nFailure prefixes stay charged; no refund"
exclude: "Disclosed excluded internals\nSwift / platform backing and compiler traffic\nNo total heap / RSS / peak guarantee"
inputs: "All native event operands supplied?\nVisits / tuples / returns / final values / errors" { shape: diamond }
conditional: "Complete scoped expressions\nActual whole-job totals remain unknown\nKeep all rows / outside records / system seeds"
fit: "Conditional fit only with full finite inputs\n20 MiB gross / 4,194,304 attempts\nDeadlines and true-return slots remain"
host: "Separate host conversion / aliases / encoding\nComplete selection and independent 8 MiB guard\nSent-body bytes fund no earlier memory"
hold: "Keep advertisement / consumption hold\nGuarded private qualification before analytic fit\nWhole review + prerequisite reviews before implementation"
comparison: "Strict certificate failure retained as comparison\nNo longer a pending human choice"
start -> raw: "1. Apply selected ADR"
raw -> calls: "2. Raw spans are not public values"
calls -> reserve: "3. Charge the explicit caller"
calls -> exclude: "Disclose internals outside guarantee"
reserve -> inputs: "4. Unknown explicit work never becomes zero"
inputs -> conditional: "5a. Saved native operands remain conditional"
inputs -> fit: "5b. Evaluate only a complete declared subject"
conditional -> hold: "6a. No guessed useful fit"
fit -> host: "6b. Independent complete wire still required"
host -> hold: "7. Full-family acceptance remains"
comparison -> start: "Context: k231 resolved the trade-off"
