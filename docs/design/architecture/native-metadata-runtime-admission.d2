direction: down
start: "Start here\nSelected strict pre-call accounting" {
  style.fill: "#16324f"
  style.font-color: white
  style.bold: true
}
stage: "Explicit raw staging candidate\nRequested aligned capacity + every write\nOwners / growth / cleanup / two walks"
publish: "Mandatory public ProviderValue adapter\nSwift String / Array / Dictionary\nCompiler and runtime ownership operations"
evidence: "Complete pre-call uppers for\nactual compiled/runtime paths?" { shape: diamond }
failed: "Current strict construction unestablished\nABI / payload / minimum / post-call size\ndo not supply the full upper" {
  style.fill: "#fff4d6"
  style.stroke: "#9b6a18"
}
choice: "Human accounting decision\nBoth alternatives are unselected" { shape: diamond }
scoped: "Recommended proposal\n20 MiB explicit raw requests + writes\nDisclose excluded runtime backing / traffic"
strict: "Alternative\nRetain strict accounting\nRequire exact implementation certificates\nUnqualified combinations refuse"
host: "Separate actual host work\nConversion / aliases / completion / encoding\n8 MiB guard after complete encoding"
hold: "Keep consumption hold\nNo useful fit / no native pass\nPreserve all choices, gates and authority"
start -> stage: "1. All saved rows / aliases / outside records"
stage -> publish: "2. Raw spans cannot replace public Swift values"
publish -> evidence: "3. Includes intermediate and failed prefixes"
evidence -> failed: "4. Available evidence does not establish it"
failed -> choice: "5. New choice, not another sizing coefficient"
choice -> scoped: "6a. Explicitly weaker accounting guarantee"
choice -> strict: "6b. Additional qualification condition"
publish -> host: "Public values still materialize here"
host -> hold: "Sent body bound pays no earlier allocation"
scoped -> hold: "7a. Needs actual selection and full reconciliation"
strict -> hold: "7b. Needs attainable source/image correspondence"
