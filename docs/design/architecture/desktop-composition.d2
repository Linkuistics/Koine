# General dependency graph. Boxes identify responsibilities, not separate processes.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Client: "Start here · ModalAnyware or another local client\nGraphQL tooling + its own credential" {class: start}
Koine: "One resident Koine process" {
  style.font-size: 22
  UI: "Native management UI\nLocal-console authority"
  HTTP: "Loopback GraphQL\nAuthenticate each request"
  Core: "Machine · platform-independent Swift\nCompose schema · authorize · execute"
  Loader: "Native plugin loader\nVerify trust before loading"
  Desktop: "Desktop provider · Swift dylib\nOwns AX observation and resolution"
  UI -> Core: "same management operations"
  HTTP -> Core: "client capability set"
  Core -> Desktop: "shared Swift framework\nauthorized resolution"
  Loader -> Desktop: "verify framework version\nbefore loading"
}
OS: "macOS\nLogin launch · Accessibility · Keychain"
Client -> Koine.HTTP: "GraphQL over loopback HTTP"
Koine.UI -> OS: "setup and permission guidance"
Koine.Desktop -> OS: "Accessibility in Koine's process"
Caption: "UI, server and providers share one process.\nClosing the management window leaves Koine resident.\nNative plugins share Koine's trust and permissions."
