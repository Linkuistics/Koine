direction: down
start: "Start here\nPreserve both ordered 2,043-row runs" {
 style.fill: "#16324f"
 style.font-color: white
 style.bold: true
}
known: "Reader API + retained local receipts\nOriginal owner correction is comparison\nGrouped slabs replace whole key partitions"
episodes: "Five episode tapes\nFirst walk / resource-or-indexed / reader extras\nSecond walk / final publication"
job: "Four once-per-job tapes\nSnapshots / registration incl. two system seeds\nGrouping / all 149 outside outcomes"
complete: "Every explicit operand known?" { shape: diamond }
reserve: "Reserve controlled requests + all raw writes\nExplicit attempts + possible cleanup\nCharge failure prefixes without refund"
unknown: "Precise failed closure\nNative operands / final values / errors unknown\nExcluded internals are a separate disclosure"
wire: "Independent complete selected GraphQL wire\nRoots / aliases / fields / escapes / errors\n8 MiB cap after full encoding"
hold: "Keep family hold\nGrouped controlled enclosure also fails fit\nActual ordering choice remains unselected"
start -> known: "1. Preserve every association"
known -> episodes: "2. Partial subtotal proves no fit"
episodes -> job: "3. No omitted or duplicate contribution"
job -> complete: "4. Full expressions, not native observations"
complete -> unknown: "5a. Current saved-input result"
complete -> reserve: "5b. Required finite evaluation"
reserve -> wire: "6. Real provider publication stays counted"
unknown -> hold: "7a. No unknown-to-zero or invented quota"
wire -> hold: "7b. Sent body gives no earlier memory bound"
