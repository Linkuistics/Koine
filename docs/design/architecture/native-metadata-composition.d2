direction: down
start: "Start here\nJoin every saved episode" {
  style.fill: "#16324f"
  style.font-color: white
  style.bold: true
}
known: "Reader API + local events\nSubtract shared read attempts once"
remaining: "Source / two walks / owners\nFinal ProviderValue publication"
admit: "Numeric runtime capacity\nand copy bounds supplied?" { shape: diamond }
failed: "Failed construction\nUnknown capacity cannot admit acquisition" {
  style.fill: "#fff4d6"
  style.stroke: "#9b6a18"
}
bound: "Reserve capacity + writes\nAttempts + possible cleanup"
values: "Full final values and errors\nKeep complete public selections"
wire: "Independent host completion / encoding\n8 MiB finished-body guard"
hold: "Keep family hold\nRuntime binding design remains live"
start -> known: "1. Preserve aliases / outside records"
known -> remaining: "2. Partial totals prove no fit"
remaining -> admit: "3. Packed sizes do not bind Swift storage"
admit -> failed: "4a. Current construction: unbound"
failed -> hold: "5a. No optional acquisition / no guessed fit"
admit -> bound: "4b. Required completion contract"
bound -> values: "5b. Charge actual prefixes; no refund"
values -> wire: "6. Unknown values keep actual wire unknown"
wire -> hold: "7. Body guard pays no earlier allocation"
