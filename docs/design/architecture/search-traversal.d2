# Selected mechanism, subject to human choices/review/native acceptance.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Effective sources\nCoverage order" {class: start}
Root: "One admitted source\nRemaining time / remaining sources"
Find: "System find owns unsorted DFS\nk196 decides later shallow-name starvation"
Marker: "Exact-root directory marker\nRequired for completion; not candidate progress"
Records: "Bounded candidates\nLiteral Foundation matching\nContinue after limit+1 within work / time bounds"
Next: "Normal exit + both pipe EOFs\nNext source only while time remains"
Remainder: "Timeout / warning / work / native stop\nExplicit source remainder + cleanup"
Start -> Root: "1 · total three-second wait"
Root -> Find: "2 · permission-qualified filesystem root"
Find -> Marker: "3 · depth zero"
Marker -> Records: "4 · descendant NUL records"
Records -> Next: "5 · actual completion"
Find -> Remainder: "5 · incomplete processing"
Next -> Root: "6 · remaining source"
