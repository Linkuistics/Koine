# Application component/activity view; proposed, no native qualification.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Application read\nworkspace:read; one admitted owner" {class: start}
Sources: "Stage index + running; inspect seeds\nChecked copy identity + Bundle ID"
Registration: "Once per identifier\nCF breadth; ordered AppKit + preferred"
Inspect: "Inspect new supplement spellings\nReuse checked seed outcomes"
Finish: "Finish the whole bounded population\nCheck all owned count/call/copy/deadline gates"
Failure: "Any global gate exhausted\nFAILED / null items; no prefix or retry"
Publish: "Freeze per-copy choices and provenance\nNo helper/agent filtering; client ranks"
Qualification: "Actual P1024 usefulness + serviceability\nWhole-producer review; all native G/N/V pending"
Start -> Sources: "1 · complete batches; count before copying"
Sources -> Registration: "2 · every coherent seed ID"
Registration -> Inspect: "3 · no repeated metadata or list walks"
Inspect -> Finish: "4 · bounded immutable observations"
Finish -> Failure: "5 · overflow, even after useful staging"
Finish -> Publish: "5 · within bounds; honest source-local uncertainty"
Publish -> Qualification: "6 · no design check supplies a native pass"
Failure -> Qualification: "6 · useful discovery remains unmet"
