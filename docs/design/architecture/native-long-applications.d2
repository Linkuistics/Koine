# Component/activity view of indexed long metadata; design only, native pending.
direction: down
classes: {
  start: {style: {fill: "#25364B"; font-color: "#FFFFFF"; bold: true; stroke-width: 3}}
}
Start: "Start here · Application read\nFixed indexed-local query" {class: start}
Item: "Actual returned indexed item\nPath + type tree + ID + name"
Identity: "Lookup-only directory identity\nBefore / after metadata episode"
Boundary: "Known plist fits?\nNecessary guard only"
Short: "Localized resource boundary UNRESOLVED\nDesign k212 + mandatory review before k7"
Long: "Exact native app-tree member\nChecked indexed scalar facts"
Unknown: "INDEXED_ITEM choice\nUNKNOWN; null bundle flags"
Limits: "All shared gates must fit\nFailure: null items, no prefix"
Client: "Preserve exact copy / identifier\nClient copy stays available"
Action: "Explicit selected action\nBoth controls; >=1,024 bytes refused"
Qualify: "Actual L1500 source + action witnesses\nG11 / N8 / V13 pending"
Start -> Item: "1 · freeze and count"
Item -> Identity: "2 · no pathname reader"
Identity -> Boundary: "3 · present stable directory"
Boundary -> Short: "4 · yes does not admit localized reads"
Boundary -> Long: "4 · no; same indexed tuple only"
Long -> Unknown: "5 · positive type; source is not current plist proof"
Short -> Qualify: "Derive safe ordinary + band-edge controls"
Unknown -> Limits: "6 · no cross-copy metadata"
Limits -> Client: "7 · publish within bounds"
Client -> Action: "8 · independent explicit submission"
Action -> Qualify: "9 · no unconstrained retry"
