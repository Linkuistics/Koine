direction: down
start: "Start here\nComplete guarded design\nUseful fit unestablished" {
 style.fill: "#16324f"
 style.font-color: white
 style.bold: true
}
whole: "Whole guarded-design review\nAnd every earned integration\nDurable reviewed artifacts"
prereqs: "Reviewed finite metadata-shape subject\nSource/access + ownership/images\nNormalization + whole discovery design"
plan: "Reviewed qualification plan\nBefore ordinary consumers\nNo prior analytic fit or released consumer"
private: "Confined private implementation\nExisting N5 / N8 / V11 / V13\nActual provider / host / signed supported VMs"
evidence: "Complete useful qualification?\nBaseline + P1024 + L1500\nNine tapes / full wire / independent witnesses\nMatched release-image correspondence" { shape: diamond }
held: "Keep advertisement / consumption held\nFailed / refused / unknown / missing cases stay live\nKnown defect repaired; valid useful exhaustion\ngoes once to human coverage decision"
release: "Release only qualified scope\nAll applicable authority / disclosure / compatibility\nAnd independent Settings / location / core duties"
start -> whole: "1. Design completion is only one prerequisite"
whole -> prereqs: "2. Reviewed design may feed prerequisites"
prereqs -> plan: "3. Review and integrate before planning"
plan -> private: "4. All eligibility terms required"
private -> evidence: "5. Enforce unchanged gates and read policy"
evidence -> held: "6a. Any required failure or unavailable subject"
evidence -> release: "6b. Full useful evidence and independent obligations pass"
